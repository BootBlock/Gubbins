# Example systemd unit for the Gubbins bridge — a read-only inventory query service.
#
# This is a template; adjust the paths and the user to your install. Setup (as root):
#
#   1. Put a Gubbins checkout somewhere stable, e.g. /opt/gubbins, owned by a dedicated
#      unprivileged user (e.g. `gubbins`). Node ≥ 24 (or ≥ 22.18 LTS — NOT any v23.x
#      build; see bridge/README.md -> Requirements for the FTS5 gap) must be on PATH
#      (/usr/bin/node).
#   2. Create /etc/gubbins-bridge.env from bridge/.env.example with your real
#      GUBBINS_SNAPSHOT_PATH. It may hold outbound credentials (MQTT, Home Assistant), so:
#         chown root:gubbins /etc/gubbins-bridge.env && chmod 640 /etc/gubbins-bridge.env
#      (Never commit this file. Set GUBBINS_BRIDGE_HOST=0.0.0.0 in it only if Home
#      Assistant runs on another machine and needs LAN access.)
#      Callers authenticate with per-user API tokens minted in the Gubbins app, so there is
#      no inbound token to put here.
#   3. Copy this file to /etc/systemd/system/gubbins-bridge.service.
#   4. systemctl daemon-reload && systemctl enable --now gubbins-bridge
#   5. journalctl -u gubbins-bridge -f   # logs never contain a token or any item data
#
[Unit]
Description=Gubbins read-only inventory query bridge
Documentation=https://github.com/BootBlock/Gubbins/tree/main/bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# A dedicated, unprivileged account that can READ the snapshot folder. Never run as root.
User=gubbins
Group=gubbins
WorkingDirectory=/opt/gubbins
ExecStart=/usr/bin/node bridge/serve.mjs
# Where the bridge remembers the stable identity consumers recognise it by (bridge/README.md ->
# "The bridge's stable identity"). StateDirectory= creates /var/lib/gubbins-bridge owned by this
# service and makes it writable through the hardening below — the checkout itself is read-only, so
# without this the bridge could never save the identity and would fall back to deriving one from
# the machine name on every start. Listed BEFORE EnvironmentFile= so the operator's own value wins.
StateDirectory=gubbins-bridge
Environment=GUBBINS_BRIDGE_ID_FILE=/var/lib/gubbins-bridge/bridge-id
# Token + snapshot path live here (chmod 640, never committed), not in this unit file.
EnvironmentFile=/etc/gubbins-bridge.env
Restart=on-failure
RestartSec=5

# Hardening — the bridge only needs to READ the snapshot and listen on a TCP socket.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
# Note: leave W^X off — V8 (Node's engine) needs writable+executable JIT pages.
MemoryDenyWriteExecute=false
# If your snapshot lives outside the (read-only) checkout — e.g. a NAS mount — grant the
# service read access to just that directory:
#   ReadOnlyPaths=/mnt/nas/gubbins
# If you enable the opt-in "push to bridge" endpoint (GUBBINS_BRIDGE_ALLOW_PUSH=on), the
# service also needs WRITE access to the snapshot's containing directory — it streams the
# pushed snapshot to a temp file and atomically renames it into place, and ProtectSystem=strict
# otherwise makes the whole filesystem read-only. Grant it only to that one directory:
#   ReadWritePaths=/opt/gubbins/local

[Install]
WantedBy=multi-user.target
