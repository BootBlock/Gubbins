#!/usr/bin/env sh
#
# Gubbins pre-push hook. The bridge is a blind spot for the ordinary local checks: it is
# NOT in the root tsconfig's project references, so `npm run type-check:app` (`tsc -b`)
# never sees it, and its tests run under their own Vitest config. Yet the bridge imports
# the app's real `src/**` modules through the `@/` alias, so an app-side change (a new
# `Item` field, a changed constant) can break the bridge's type-check or tests without any
# bridge file being touched. This repo pushes straight to `main` with no branch protection,
# so a red CI run blocks nothing — this hook is the gate that keeps the bridge green.
#
# The companion browser extension (`extension/`) is the same blind spot for the same reason: it
# is in no tsconfig the ordinary checks build, and its Vite library-mode build strips types
# without checking them — yet its three entry points import the app's real
# `src/features/scraping/**` modules, including the allow-list gate that keeps the privileged
# background worker from fetching for an arbitrary origin (issue #557). So the hook
# type-checks it too.
#
# It runs the bridge type-check, tests and boot-smoke, plus the extension type-check, before a
# push, but ONLY when the commits touch `src/**`, `bridge/**` or `extension/**` (a docs-only or
# config-only push skips it and stays fast).
# Any failure aborts the push. In a genuine emergency, bypass with `git push --no-verify`.
#
# Auto-wired by the "prepare" npm script (sets core.hooksPath = .githooks) on `npm install`.

set -u

red=''
reset=''
if [ -t 2 ]; then
  red="$(printf '\033[31m')"
  reset="$(printf '\033[0m')"
fi

note() { printf '%s\n' "$*" >&2; }
err() { printf '%spre-push: %s%s\n' "$red" "$*" "$reset" >&2; }

zero='0000000000000000000000000000000000000000'

# Collect the files changed by the commits being pushed, across every pushed ref. The
# pre-push protocol feeds one line per ref on stdin: "<local_ref> <local_oid> <remote_ref>
# <remote_oid>". We diff each remote_oid..local_oid range; when the remote has no such ref
# yet (remote_oid is all-zero) the range is unknown, so we fail safe and run the checks.
changed=''
run_checks=0
saw_ref=0

while read -r _local_ref local_oid _remote_ref remote_oid; do
  [ -z "${local_oid:-}" ] && continue
  saw_ref=1
  # A branch deletion (local_oid all-zero) pushes no content — nothing to check.
  case "$local_oid" in "$zero") continue ;; esac
  if [ "$remote_oid" = "$zero" ]; then
    # New ref on the remote: can't cheaply bound the range, so run the checks to be safe.
    run_checks=1
    break
  fi
  range_files="$(git diff --name-only "$remote_oid" "$local_oid" 2>/dev/null || true)"
  changed="$changed
$range_files"
done

# stdin gave us no refs at all (e.g. an odd invocation): fail safe and run the checks.
[ "$saw_ref" -eq 0 ] && run_checks=1

if [ "$run_checks" -ne 1 ]; then
  if printf '%s\n' "$changed" | grep -qE '^(src|bridge|extension)/'; then
    run_checks=1
  fi
fi

if [ "$run_checks" -ne 1 ]; then
  exit 0  # Nothing touching the app source, the bridge or the extension — skip the gate.
fi

note 'pre-push: app/bridge/extension changes detected — running the bridge + extension checks…'

if ! npm run --silent type-check:bridge; then
  err 'bridge type-check failed (tsc -p bridge/tsconfig.json) — push aborted.'
  note 'The bridge imports the app source via `@/`, so an app-side change can break it.'
  note 'Fix the type error (or bypass with `git push --no-verify`).'
  exit 1
fi

if ! npm run --silent test:bridge; then
  err 'bridge tests failed (vitest --config bridge/vitest.config.ts) — push aborted.'
  note 'Fix the failing bridge tests (or bypass with `git push --no-verify`).'
  exit 1
fi

# The boot-smoke is the ONLY check that exercises Node's strip-only TypeScript loader: the
# type-check above accepts parameter properties / `enum` / `namespace` (they are valid
# TypeScript) and Vitest transpiles via esbuild (a full transform), so a construct the loader
# cannot execute passes both and then fails at import time — leaving the bridge unable to boot
# at all. It costs a few seconds (start the servers, hit /health, exit) and is the difference
# between catching that here and shipping a dead bridge to `main`.
if ! npm run --silent smoke:bridge; then
  err 'bridge boot-smoke failed (node bridge/smoke.mjs) — push aborted.'
  note 'The bridge could not start. If this is ERR_UNSUPPORTED_TYPESCRIPT_SYNTAX, something in'
  note 'its import graph (bridge/** or the src/** modules it imports) uses a constructor'
  note 'parameter property, `enum` or `namespace` — none of which Node can strip.'
  note 'If instead it failed to bind a port, something local is already on the smoke port —'
  note 'set GUBBINS_SMOKE_PORT to a free one and re-push.'
  note 'Fix the offending syntax (or bypass with `git push --no-verify`).'
  exit 1
fi

# The extension's own gate. Nothing can execute it outside a browser, so there is no suite or
# boot-smoke to run here (the source-text guards it does have belong to the app's suite) — the
# type-check is the whole of it, and it is fast: a single `tsc --noEmit`.
if ! npm run --silent type-check:extension; then
  err 'extension type-check failed (tsc -p extension/tsconfig.json) — push aborted.'
  note 'The extension imports the app source by relative path, so an app-side change can break it.'
  note 'Fix the type error (or bypass with `git push --no-verify`).'
  exit 1
fi

exit 0
