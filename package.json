{
  "name": "gubbins",
  "private": true,
  "version": "0.31.0",
  "releaseDate": "2026-08-17",
  "schemaVersion": 8,
  "type": "module",
  "description": "Gubbins — a local-first, offline-capable PWA for tracking electronics, 3D-printing supplies, tools, and general inventory.",
  "license": "MIT",
  "author": "Joe Cox <BootBlock@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BootBlock/Gubbins.git"
  },
  "bugs": {
    "url": "https://github.com/BootBlock/Gubbins/issues"
  },
  "homepage": "https://bootblock.github.io/Gubbins/",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "node -e \"try{require('node:child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch{}\"",
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle-size.mjs",
    "build:extension": "node extension/build.mjs",
    "ocr:assets": "node scripts/setup-ocr-assets.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "node scripts/run-unit-tests.mjs",
    "test:bridge": "vitest run --config bridge/vitest.config.ts",
    "smoke:bridge": "node bridge/smoke.mjs",
    "test:e2e": "node scripts/browser-smoke.mjs",
    "wiki:check": "node scripts/wiki-check.mjs",
    "type-check": "npm run type-check:app && npm run type-check:bridge",
    "type-check:app": "tsc -b --noEmit",
    "type-check:bridge": "tsc --noEmit -p bridge/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.29",
    "@tanstack/react-virtual": "^3.14.9",
    "@zxing/library": "^0.23.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.3",
    "react-hook-form": "^7.85.0",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.32",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.2",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
